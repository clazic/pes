{
  "name": "pes-dashboard-v2-react-mockup",
  "private": true,
  "version": "0.0.0",
  "description": "PES 웹 대시보드 v2 — React + Vite + TypeScript + Tailwind CSS + shadcn/ui 시안 (합성 목 데이터만, 네트워크 호출 없음)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview --port 4173 --strictPort"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.68.0",
    "pretendard": "1.3.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.8.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "oxlint": "1.93.0",
    "oxlint-tailwindcss": "1.17.1",
    "tailwindcss": "4.3.4",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
