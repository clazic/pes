{
  "name": "bootstrap_ok",
  "description": "project.bootstrap이 서비스를 지나 프로젝트·owner·정책·판을 한 번에 만든다. 결과는 project_id·owner_actor_id·edition_id 등을 담는다.",
  "steps": [
    {
      "request": {
        "command": "project.bootstrap",
        "project": "none",
        "actor": "none",
        "client_request_id": "req-boot-1",
        "payload": { "slug": "synthetic-new", "topic": "새 합성 주제", "owner_display_name": "새 합성 소유자" }
      },
      "expect": {
        "ok": {
          "replayed": false,
          "result": {
            "project_id": "$any",
            "owner_user_id": "$any",
            "owner_actor_id": "$any",
            "edition_id": "$any",
            "policy_id": "$any"
          }
        }
      }
    }
  ]
}
