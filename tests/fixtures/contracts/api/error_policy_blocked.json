{
  "name": "error_policy_blocked",
  "description": "Go가 꺼져 있으면 A 방식 claim은 403 policy_blocked, 재시도 표시 없음, 소유자에게 정책을 켜라고 안내한다.",
  "agents": {
    "agent": {
      "kind": "internal_ai",
      "scopes": [
        "context:read",
        "run:claim",
        "run:submit",
        "file:write",
        "file:read"
      ]
    }
  },
  "steps": [
    {
      "before": [
        "go_off"
      ],
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/claims",
        "auth": "agent:agent",
        "body": {
          "mode": "A",
          "runtime": "builtin",
          "provider": "opencode-go",
          "model": "opencode-go/deepseek-v4.1-flash"
        }
      },
      "expect": {
        "status": 403,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "error": {
            "code": "policy_blocked",
            "message": "$string",
            "retryable": false,
            "target": "$any",
            "details": "$any",
            "next_action": "owner_enable_policy"
          },
          "$absent": [
            "data"
          ]
        },
        "headers_absent": [
          "Retry-After"
        ]
      }
    }
  ]
}
