{
  "name": "question_publish_submit_ok",
  "description": "소유자가 질문 세트를 게시하고 같은 질문에 답을 제출한다. 답은 게시 당시 질문 버전에 묶인다.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/projects/${project}/context",
        "auth": "owner"
      },
      "save": {
        "stage": "data.stages.0.stage_id"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/questions",
        "auth": "owner",
        "body": {
          "format_version": "1.0",
          "stage_id": "${stage}",
          "round_id": null,
          "purpose": "stage_start",
          "direction": "agent_to_human",
          "question": {
            "text": "합성 질문입니다",
            "type": "single",
            "required": true,
            "allow_comment_as_answer": false,
            "options": [
              {
                "value": "a",
                "label": "합성 A",
                "recommended": true
              },
              {
                "value": "b",
                "label": "합성 B"
              }
            ],
            "default_value": "b"
          }
        }
      },
      "save": {
        "set": "data.question_set_id",
        "question": "data.question.id",
        "question_version": "data.question.version_id"
      },
      "expect": {
        "status": 201,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "replayed": false,
          "data": {
            "question_set_id": "$string",
            "question": {
              "id": "$string",
              "version_id": "$string",
              "version_no": "1",
              "state": "open",
              "asked_by_actor_id": "${owner_actor}",
              "intended_actor_id": "$any"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/submissions",
        "auth": "owner",
        "body": {
          "format_version": "1.0",
          "set_id": "${set}",
          "answers": [
            {
              "question_id": "${question}",
              "question_version_id": "${question_version}",
              "value": "a",
              "comment": "합성 의견"
            }
          ],
          "submitted_via": "web",
          "client_request_id": "subreq-fixture-1"
        }
      },
      "expect": {
        "status": 201,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "data": {
            "submission": {
              "id": "$string",
              "received_at": "$int",
              "state": "accepted"
            },
            "answers": {
              "$array_of": {
                "question_id": "${question}",
                "answer_version_id": "$string",
                "state": "submitted"
              },
              "min": 1,
              "max": 1
            }
          }
        }
      }
    }
  ]
}
