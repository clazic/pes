{
  "name": "claim_wait_ok",
  "description": "claim 뒤 wait는 waiting_human으로 바꾸고 lease를 놓는다(wait_ms 없음 = 바로 응답).",
  "agents": {
    "agent": {
      "scopes": [
        "context:read",
        "run:claim",
        "run:submit",
        "file:write",
        "file:read"
      ]
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/claims",
        "auth": "agent:agent",
        "body": {
          "mode": "B",
          "runtime": "synthetic-runtime",
          "provider": "synthetic",
          "model": "synthetic-model"
        }
      },
      "save": {
        "run": "data.run_id",
        "lease": "data.lease_id",
        "fence": "data.fence"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/runs/${run}/wait",
        "auth": "agent:agent",
        "body": {
          "lease_id": "${lease}",
          "fence": "${fence}",
          "reason": "사람 입력 대기"
        }
      },
      "expect": {
        "status": 200,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "data": {
            "run_id": "${run}",
            "status": "waiting_human"
          },
          "replayed": false
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/projects/${project}/context",
        "auth": "owner"
      },
      "expect": {
        "status": 200,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "data": {
            "lease": "$null"
          }
        }
      }
    }
  ]
}
