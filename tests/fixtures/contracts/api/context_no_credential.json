{
  "name": "context_no_credential",
  "description": "자격이 없으면 401 unauthenticated.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/v1/projects/${project}/context",
        "auth": "none"
      },
      "expect": {
        "status": 401,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "error": {
            "code": "unauthenticated",
            "message": "$string",
            "retryable": false,
            "target": "$any",
            "details": "$any",
            "next_action": "$any"
          },
          "$absent": [
            "data"
          ]
        }
      }
    }
  ]
}
