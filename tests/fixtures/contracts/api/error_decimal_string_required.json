{
  "name": "error_decimal_string_required",
  "description": "fence가 JSON 숫자이면 400. 10진 문자열만 받는다.",
  "agents": {
    "agent": {
      "scopes": [
        "context:read",
        "run:claim",
        "run:submit",
        "file:write",
        "file:read"
      ]
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/claims",
        "auth": "agent:agent",
        "body": {
          "mode": "B",
          "runtime": "synthetic-runtime",
          "provider": "synthetic",
          "model": "synthetic-model"
        }
      },
      "save": {
        "run": "data.run_id",
        "lease": "data.lease_id"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/api/v1/projects/${project}/runs/${run}/complete",
        "auth": "agent:agent",
        "body": {
          "lease_id": "${lease}",
          "fence": 1
        }
      },
      "expect": {
        "status": 400,
        "json": {
          "format_version": "1.0",
          "request_id": "$string",
          "error": {
            "code": "invalid_payload",
            "message": "$string",
            "retryable": false,
            "target": "$any",
            "details": "$any",
            "next_action": "$any"
          },
          "$absent": [
            "data"
          ]
        }
      }
    }
  ]
}
